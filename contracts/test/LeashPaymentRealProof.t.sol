pragma solidity ^0.8.27;

import "../src/LeashPayment.sol";
import "../src/LeashVerifier.sol";

interface Vm {
    function readFileBinary(string calldata path) external view returns (bytes memory);
}

// End-to-end against the bb-generated HonkVerifier using a real proof from circuits/
// (fixture generated by `nargo execute` + `bb prove -t evm`, see test/fixtures/README.md).
contract LeashPaymentRealProofTest {
    Vm constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));

    LeashPayment payment;
    address payable constant MERCHANT = payable(0x1234567890123456789012345678901234567890);
    address payable constant ATTACKER = payable(0x000000000000000000000000000000000000dEaD);

    bytes32 constant POLICY_COMMITMENT = 0x09133620fa909d1ae63144fe7b802a6746fe87be8b3ed165aed34d165383acff;
    bytes32 constant MERCHANT_HASH = 0x2251558a6d5a9c78d6af29ca25291e11cccb168a48b48c1daa9650055f9b06ec;
    bytes32 constant NONCE = bytes32(uint256(1));
    uint256 constant AMOUNT = 300;

    function setUp() public {
        payment = new LeashPayment(address(new HonkVerifier()));
        payment.registerPolicy(POLICY_COMMITMENT);
    }

    function _proof() internal view returns (bytes memory) {
        return vm.readFileBinary("test/fixtures/proof");
    }

    function test_real_proof_pays_proven_recipient() public {
        uint256 before = MERCHANT.balance;
        payment.executePayment{value: AMOUNT}(POLICY_COMMITMENT, AMOUNT, MERCHANT_HASH, NONCE, MERCHANT, _proof());
        require(MERCHANT.balance == before + AMOUNT, "merchant not paid");
        require(payment.usedNonces(NONCE), "nonce not consumed");
    }

    function test_real_proof_rejects_swapped_recipient() public {
        bytes memory proof = _proof();
        uint256 before = ATTACKER.balance;
        try payment.executePayment{value: AMOUNT}(POLICY_COMMITMENT, AMOUNT, MERCHANT_HASH, NONCE, ATTACKER, proof) {
            revert("proof for MERCHANT must not pay ATTACKER");
        } catch {}
        require(ATTACKER.balance == before, "attacker received funds");
        require(!payment.usedNonces(NONCE), "nonce consumed on failure");
    }

    function test_real_proof_rejects_swapped_nonce() public {
        bytes memory proof = _proof();
        bytes32 otherNonce = bytes32(uint256(2));
        try payment.executePayment{value: AMOUNT}(POLICY_COMMITMENT, AMOUNT, MERCHANT_HASH, otherNonce, MERCHANT, proof) {
            revert("proof for nonce 1 must not verify with nonce 2");
        } catch {}
        require(!payment.usedNonces(otherNonce), "nonce consumed on failure");
    }

    function test_real_proof_replay_rejected() public {
        bytes memory proof = _proof();
        payment.executePayment{value: AMOUNT}(POLICY_COMMITMENT, AMOUNT, MERCHANT_HASH, NONCE, MERCHANT, proof);
        try payment.executePayment{value: AMOUNT}(POLICY_COMMITMENT, AMOUNT, MERCHANT_HASH, NONCE, MERCHANT, proof) {
            revert("replay must fail");
        } catch Error(string memory reason) {
            require(keccak256(bytes(reason)) == keccak256("Nonce already used"), reason);
        }
    }

    receive() external payable {}
}
