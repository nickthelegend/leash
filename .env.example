# LEASH configuration. Copy to .env.local (gitignored) and fill in; never commit real values.
# The repo-root .env.local is read by pnpm paypal:e2e, the gateway and leash-mcp; the Next console
# (pnpm dev:web) reads apps/web/.env.local, so copy it there too.

# PayPal sandbox (REST app credentials). Without them every PayPal call reports
# "Setup required (PAYPAL_CLIENT_ID)" and nothing is consumed.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Sandbox business account that receives payments (13-char merchant id). Adds a PayPal merchant to
# the default allowlist; its payee is bound into proofs.
PAYPAL_PAYEE_MERCHANT_ID=
# Only for `leash-mcp --upstream "npx -y @paypal/mcp --tools=all"` (bearer token for PayPal's MCP server).
PAYPAL_ACCESS_TOKEN=

# Owner device / agent
LEASH_HOME=
LEASH_POLICY_OWNER_ADDRESS=
# Owner of the web console's policies (defaults to Anvil dev account #0)
LEASH_CONSOLE_OWNER=
LEASH_GATEWAY_URL=http://localhost:3000
# 1 = allow proving in a production web build (owner device); 0 = verify-only even in dev
LEASH_OWNER_DEVICE=
LEASH_DAILY_CAP_CENTS=
# Base URL PayPal redirects the buyer back to (defaults to the request origin)
LEASH_PUBLIC_URL=

# Standalone verify-only Express gateway
GATEWAY_PORT=3001

# EVM rail (local Anvil only; scripts/demo-anvil.sh writes these to .demo/anvil.env)
LEASH_RPC_URL=
LEASH_PAYMENT_CONTRACT_ADDRESS=
LEASH_SENDER_ADDRESS=
LEASH_PAY_FROM_ESCROW=
