# PayPal AI Hackathon - LEASH Configuration
# Set these in .env.local to enable real PayPal sandbox payments
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Off-chain Leash Gateway Port
PORT=3001
GATEWAY_PORT=3001

# Next.js Web Console Port
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# Optional EVM Stretch Target (e.g. Celo Alfajores / Arbitrum Sepolia)
LEASH_RPC_URL=
LEASH_PAYMENT_CONTRACT_ADDRESS=
LEASH_PRIVATE_KEY=

# Payee address bound into every proof as the `recipient` public input
LEASH_RECIPIENT_ADDRESS=
